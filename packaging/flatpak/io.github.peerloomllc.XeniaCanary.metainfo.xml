  <name>Xenia Canary</name>
  <summary>Play Xbox 360 games</summary>
  <developer id="io.github.peerloomllc">
    <name>peerloomllc</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause</project_license>
  <description>
    <p>
      A build of the Xenia Canary Xbox 360 emulator for Linux, with save
      states, a game library, and work on the things a native Linux build
      needs that the Windows one does not.
    </p>
    <p>This is a fork. The emulator itself is the work of the Xenia project.</p>
  </description>
  <launchable type="desktop-id">io.github.peerloomllc.XeniaCanary.desktop</launchable>
  <url type="homepage">https://github.com/peerloomllc/xenia-canary</url>
